# ── 运行时数据（绝不提交：含用户路径 / 图片索引 / 收藏夹 / 画师备注 / 画师串）──
userdata/

# ── 画师库数据 ──
# 不随仓库分发。插件「画师库」页有「⬇ 下载画师库数据」按钮，从 Release 附件取
# （artists-data.zip，约 3.3 MB / 解压 18 MB）；也可用 GALLERY4_DATA_DIR 指向自备目录，
# 或运行 tools/build_artist_db.py 自己抓。
data/

# 用户自己的数据即使放进 data/ 也绝不提交 —— 收藏了哪些画师、用哪些画师出图：
data/*用户自定义*
data/WeiLin画师库-用户自定义.md

# ── Python 缓存 ──
__pycache__/
*.py[cod]

# ── 本地备份（改文件前留的）──
*.bak
*.bak_*
*.bak2_*
*.orig
*.rej

# ── 打包产物 ──
*.zip
dist/
build/

# ── 日志 ──
*.log

# ── 系统文件 ──
.DS_Store
Thumbs.db
